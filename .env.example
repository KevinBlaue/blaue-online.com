# Copy to .env on the deploy host and adjust. .env is not tracked.

# Contact form API, inlined into the static build by Next.js.
# Defaults: http://localhost:8080/api/contact on localhost, otherwise the production API.
NEXT_PUBLIC_CONTACT_ENDPOINT=https://api.example.com/api/contact

# Directory Nginx serves the static export from (used by npm run deploy).
SITE_ROOT=/var/www/html/example.com

# Space-separated URLs smoke-tested after deploying.
DEPLOY_URLS="https://example.com https://www.example.com"
